---
layout: base.njk
---
<article class="location">
  <div class="location__hero" style="background-image: url('{{ coverImage }}');">
    <div class="location__hero-scrim">
      <p class="location__eyebrow">{{ type }} &middot; {{ region }}</p>
      <h1 class="location__title">{{ title }}</h1>
      {% if dateExplored %}<p class="location__date">Explored {{ dateExplored | readableDate }}</p>{% endif %}
    </div>
  </div>

  {% if blurb %}
  <div class="location__blurb">
    {{ blurb | safe }}
  </div>
  {% endif %}

  <div class="location__gallery">
    {% for img in images %}
    <figure class="location__photo">
      <img src="{{ img.src or img }}" alt="{{ img.caption or (title + ' — photo ' + loop.index) }}" loading="lazy">
      {% if img.caption %}<figcaption>{{ img.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div>

  <p class="location__back"><a href="/">&larr; Back to all locations</a></p>
</article>
