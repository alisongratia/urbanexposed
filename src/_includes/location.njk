---
layout: base.njk
---
<article class="location">
  <div class="location__hero" data-hero data-cover="{{ coverImage or '' }}">
    <div class="location__hero-scrim">
      <p class="location__eyebrow">{{ type }}{% if demolished %} &middot; {{ region }} &middot; <span class="location__demolished">Demolished</span>{% endif %}</p>
      <h1 class="location__title">{{ title }}</h1>
    </div>
  </div>

  {% if blurb %}
  <div class="location__blurb">
    {{ blurb | safe }}
  </div>
  {% endif %}

  <div class="location__gallery" data-gallery="{{ page.fileSlug }}">
    <p class="location__loading">Loading photos&hellip;</p>
  </div>

  <p class="location__back"><a href="{{ '/' | url }}">&larr; Back to all locations</a></p>
</article>
