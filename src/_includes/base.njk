<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <header class="site-header">
    <a class="site-brand" href="{{ '/' | url }}">
      <span class="site-brand__mark">▲</span>
      <span class="site-brand__text">{{ site.title }}</span>
    </a>
    <nav class="site-nav">
      <a href="{{ '/' | url }}">Locations</a>
      <a href="{{ '/about/' | url }}">About</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>{{ site.title }} — {{ site.tagline }}.</p>
    <p class="site-footer__note">Locations stay a little vague on purpose — it's part of how these places stay standing.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    window.SUPABASE_CONFIG = {
      url: "{{ site.supabase.url }}",
      anonKey: "{{ site.supabase.anonKey }}",
      bucket: "{{ site.supabase.bucket }}"
    };
    window.supabaseClient = supabase.createClient(window.SUPABASE_CONFIG.url, window.SUPABASE_CONFIG.anonKey);
  </script>
  <script src="{{ '/js/gallery.js' | url }}"></script>
</body>
</html>
