---
layout: base.njk
title: null
---
<section class="hero">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}</p>
</section>

<section class="grid">
  {% for location in collections.locations %}
  <a class="card" href="{{ location.url | url }}">
    <div class="card__image" data-card-slug="{{ location.fileSlug }}" data-cover="{{ location.data.coverImage or '' }}"></div>
    <div class="card__body">
      <h2 class="card__title">{{ location.data.title }}</h2>
      <p class="card__meta">{{ location.data.type }}{% if location.data.demolished %} &middot; {{ location.data.region }} &middot; Demolished{% endif %}</p>
    </div>
  </a>
  {% endfor %}
</section>

<section class="subscribe">
  <h2 class="subscribe__title">Follow along</h2>
  <p class="subscribe__note">New locations, sent when there's something worth showing.</p>
  <form class="subscribe__form" data-subscribe-form>
    <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address">
    <button type="submit">Subscribe</button>
  </form>
  <p class="subscribe__status" data-subscribe-status hidden></p>
</section>
